# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- YouTube Data API v3 -----------------------------------------------------
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
# Recommended: restrict the key to "YouTube Data API v3" only.
YOUTUBE_API_KEY=
# Max quota units ONE PoC run may spend (default project quota is 10,000 units/day).
YOUTUBE_POC_MAX_UNITS=1500

# --- Bluesky (optional) ------------------------------------------------------
# Public read endpoints need no credentials. An App Password (Settings -> App Passwords,
# NOT your main password) enables the documented authenticated search path.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Max HTTP requests ONE PoC run may make.
BLUESKY_POC_MAX_REQUESTS=200

# --- Not yet enabled (Phase 0 status: AUTH_REQUIRED / BLOCKED, see docs/feasibility) ---
# APIFY_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# THREADS_ACCESS_TOKEN=
