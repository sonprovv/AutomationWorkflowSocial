# Copy this file to .env and fill it in. start.bat / start.command create .env automatically on first run.
# .env is git-ignored: never commit real secrets, and never paste API keys into chat tools.
# ---------------------------------------------------------------------------

# --- Local runtime ------------------------------------------------------------
# Public port for the web UI and API (same origin). If the port is busy, choose another, e.g. 18970.
APP_PORT=18966
# Timezone used to display data and run schedules. Storage is always UTC.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Leave empty to use the built-in embedded PostgreSQL (stored in .data/postgres).
# Set this to use your own server instead, e.g. postgresql://user:pass@127.0.0.1:5432/social_spy
DATABASE_URL=
# Port for the embedded PostgreSQL (native mode only).
EMBEDDED_PG_PORT=18968
# Redis or a Redis-compatible server such as Memurai. If unreachable, the app runs in inline mode:
# no worker and no scheduler.
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
OPEN_BROWSER=true
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=600
MAX_RETRIES=3
INITIAL_POSTS_PER_ACCOUNT=20
# Max posts one metrics refresh job updates (most overdue first)
METRICS_REFRESH_MAX_POSTS=500
PROVIDER_HEALTH_EVERY_MINUTES=30
# Scheduler (WF02/04/05/13/14). In inline mode (no Redis) the tick runs inside the API process.
SCHEDULER_IN_PROCESS=true
SCHEDULER_TICK_SECONDS=60
SCHEDULER_MAX_SYNCS_PER_TICK=20
# WF14: delete posts the provider no longer returns after a grace period (Bluesky Developer Guidelines)
CLEANUP_DELETE_UNAVAILABLE=true
CLEANUP_UNAVAILABLE_GRACE_HOURS=72
# Exports (Excel/CSV/JSON). Files are deleted after EXPORT_TTL_DAYS by WF14.
EXPORT_DIR=.data/exports
EXPORT_TTL_DAYS=7
EXPORT_MAX_POSTS=50000
# AI analysis (WF08, Claude). Leave empty to keep AI off. Never commit a real key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_FALLBACKS=true
AI_INPUT_USD_PER_MTOK=4
AI_OUTPUT_USD_PER_MTOK=20
AI_DAILY_MAX_ANALYSES=50

# --- YouTube Data API v3 -----------------------------------------------------
# Setup: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3"
#        -> Credentials -> create an API key.
# Recommended: restrict the key to "YouTube Data API v3" only.
YOUTUBE_API_KEY=
# Daily quota cap the app enforces on itself. The default project quota is 10,000 units/day.
YOUTUBE_DAILY_QUOTA_UNITS=8000
# Maximum quota units a single PoC run (npm run poc) may spend.
YOUTUBE_POC_MAX_UNITS=1500

# --- Bluesky (optional) ------------------------------------------------------
# Public reads need no credentials. An App Password enables the documented authenticated search path.
# Create one under Settings -> App Passwords. Do NOT use your main password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_DAILY_REQUESTS=20000
BLUESKY_POC_MAX_REQUESTS=200

# --- Not enabled yet -----------------------------------------------------------
# Phase 0 status for these is AUTH_REQUIRED or BLOCKED; see docs/feasibility.
# APIFY_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# THREADS_ACCESS_TOKEN=
