{
  "name": "SSS — daily report (calls the local API)",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }] } }, "name": "Every day 06:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0] },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SSS_URL || 'http://127.0.0.1:18966' }}/api/v1/reports",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"projectId\": \"{{ $env.SSS_PROJECT_ID }}\", \"kind\": \"daily\", \"notify\": false }",
        "options": {}
      },
      "name": "Queue report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    { "parameters": { "amount": 30, "unit": "seconds" }, "name": "Wait 30 s", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [440, 0] },
    { "parameters": { "url": "={{ ($env.SSS_URL || 'http://127.0.0.1:18966') + $('Queue report').item.json.status_url }}", "options": {} }, "name": "Job status", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [660, 0] },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "or", "conditions": [
          { "leftValue": "={{ $json.status }}", "rightValue": "SUCCEEDED", "operator": { "type": "string", "operation": "equals" } },
          { "leftValue": "={{ $json.status }}", "rightValue": "PARTIAL_SUCCESS", "operator": { "type": "string", "operation": "equals" } }
        ] }
      },
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    { "parameters": { "url": "={{ ($env.SSS_URL || 'http://127.0.0.1:18966') + '/api/v1/reports/' + $json.result.id }}", "options": {} }, "name": "Get report", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, -100] },
    { "parameters": {}, "name": "Send it with your own node (Slack, Sheets, …)", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1320, -100] },
    { "parameters": {}, "name": "Not finished: check the Job Monitor", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1100, 100] }
  ],
  "connections": {
    "Every day 06:00": { "main": [[{ "node": "Queue report", "type": "main", "index": 0 }]] },
    "Queue report": { "main": [[{ "node": "Wait 30 s", "type": "main", "index": 0 }]] },
    "Wait 30 s": { "main": [[{ "node": "Job status", "type": "main", "index": 0 }]] },
    "Job status": { "main": [[{ "node": "Finished?", "type": "main", "index": 0 }]] },
    "Finished?": { "main": [[{ "node": "Get report", "type": "main", "index": 0 }], [{ "node": "Not finished: check the Job Monitor", "type": "main", "index": 0 }]] },
    "Get report": { "main": [[{ "node": "Send it with your own node (Slack, Sheets, …)", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
