{
  "name": "social-spy-automation",
  "version": "0.0.0",
  "private": true,
  "description": "Social Intelligence Automation \u2014 local-first competitor & content research (see SOCIAL_SPY_AUTOMATION_PLAN.md)",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/config",
    "packages/shared",
    "packages/database",
    "packages/queue",
    "packages/policy-engine",
    "packages/services",
    "packages/collectors/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "poc": "tsx tools/feasibility/src/cli.ts",
    "poc:summary": "tsx tools/feasibility/src/summary.ts",
    "postinstall": "npm run generate -w @sss/database --silent",
    "db:generate": "npm run generate -w @sss/database",
    "db:migrate:new": "npm run migrate:new -w @sss/database --",
    "slice": "tsx tools/local/src/slice.ts",
    "phase2:sync": "tsx tools/local/src/phase2-sync.ts",
    "phase3:discover": "tsx tools/local/src/phase3-discovery.ts",
    "phase5:e2e": "tsx tools/local/src/phase5-e2e.ts",
    "phase6:analytics": "tsx tools/local/src/phase6-analytics.ts",
    "doctor": "tsx tools/local/src/doctor.ts",
    "start:native": "tsx tools/local/src/start.ts",
    "stop:native": "tsx tools/local/src/stop.ts",
    "build:web": "npm run build -w @sss/web"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
